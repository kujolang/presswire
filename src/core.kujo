from src.args import parse_args
from src.common import get, has, valid_timestamp, find_sensitive_key, canonical_json, parse_object, safe_id, envelope
from src.storage import initialize, save_new, load_record, list_records, validate_state_path

SLUG := "presswire"
NAME := "PressWire"
VERSION := "0.1.0"
CONTRACT := "1.0.0"
DEFAULT_STATE := ".presswire"
COMMANDS := ["preflight","adapters","capabilities","schedule","publish","status","correct","unpublish","receipt","history","doctor","version","init","show","export","validate","report"]
EFFECT_COMMANDS := ["schedule","publish","correct","unpublish"]

func flag(parsed, name, fallback) {
    if type(parsed)=="dict" && has_key(parsed,"flags")==1 && type(parsed["flags"])=="dict" && has_key(parsed["flags"], name) == 1 { return parsed["flags"][name] }
    return fallback
}

func load_config(path) {
    if path == "" { return {"ok": true, "value": {}} }
    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "config_not_found", "error": "config must be a regular non-symlink file"} }
    if file_size(path) > 65536 { return {"ok": false, "code": "config_too_large", "error": "config exceeds 64 KiB"} }
    parsed := parse_object(read_file(path), "config"); if !parsed["ok"] { return parsed }
    for key in keys(parsed["value"]) { if !has(["state","actor"], key) { return {"ok": false, "code": "unknown_config_key", "error": "unknown config key: " + key} } }
    return parsed
}

func setting(parsed, config, name, fallback) {
    value := flag(parsed, name, null)
    if type(value) != "null" && value != "" { return value }
    return get(config, name, fallback)
}

func metadata() { return {"schema_version":"1.0.0","tool":SLUG,"tool_version":VERSION,"contract_version":CONTRACT,"created_at":now_utc()} }

func read_payload(parsed) {
    path := flag(parsed, "input", "")
    if path == "" { return {"ok": true, "value": {"schema_version":"1.0.0"}} }
    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "input_not_found", "error": "input must be a regular non-symlink file"} }
    if file_size(path) > 1048576 { return {"ok": false, "code": "input_too_large", "error": "input exceeds 1 MiB"} }
    parsed_input := parse_object(read_file(path), "input"); if !parsed_input["ok"] { return parsed_input }
    payload := parsed_input["value"]; schema := get(payload, "schema_version", "1.0.0")
    if type(schema) != "string" || !starts_with(schema, "1.") { return {"ok": false, "code": "incompatible_schema", "error": "input schema major must be 1"} }
    sensitive := find_sensitive_key(payload, ""); if sensitive != "" { return {"ok": false, "code": "secret_rejected", "error": "sensitive field is not allowed: " + sensitive} }
    if type(get(payload, "provenance", [])) != "array" { return {"ok": false, "code": "invalid_provenance", "error": "provenance must be an array"} }
    return {"ok": true, "value": payload}
}

func validate_effect(command, payload, parsed) {
    if !has(EFFECT_COMMANDS, command) { return "" }
    if flag(parsed, "act", false) != true || flag(parsed, "yes", false) != true { return "effects require --act --yes" }
    for key in ["approval_id","approval_record_path","manifest_checksum","destination","authorized_action"] {
        value := get(payload, key, ""); if type(value) != "string" || trim(value) == "" || len(value) > 4096 { return "approval scope missing or invalid: " + key }
    }
    if !safe_id(payload["approval_id"]) { return "approval_id must be a safe record id" }
    if !regex_match(lower(payload["manifest_checksum"]), "^[a-f0-9]{64}$") { return "manifest_checksum must be SHA-256 hex" }
    if payload["authorized_action"] != command { return "approval action mismatch" }
    return ""
}

func validate_approval(command, payload) {
    if !has(EFFECT_COMMANDS, command) { return "" }
    path := payload["approval_record_path"]
    if !path_is_file(path) || path_is_symlink(path) || file_size(path) > 1048576 { return "VersionSeal approval record must be a bounded regular file" }
    parsed := parse_object(read_file(path), "VersionSeal approval record"); if !parsed["ok"] { return "invalid VersionSeal approval record" }
    record := parsed["value"]
    if get(record,"id","") != payload["approval_id"] || get(record,"command","") != "approve" || get(record,"record_type","") != "decision" { return "approval identity mismatch" }
    if get(record,"schema_version","") != "1.0.0" || get(record,"contract_version","") != "1.0.0" || get(record,"tool_version","") != "0.1.0" { return "approval contract mismatch" }
    if !valid_timestamp(get(record,"created_at","")) || type(get(record,"actor",null)) != "string" || trim(record["actor"]) == "" { return "approval provenance is invalid" }
    approved := get(record, "payload", {})
    if type(approved) != "dict" || get(approved,"human_actor","") != record["actor"] { return "approval actor binding mismatch" }
    if get(approved,"manifest_checksum","") != payload["manifest_checksum"] { return "approval checksum scope mismatch" }
    if get(approved,"destination","") != payload["destination"] || get(approved,"action","") != command { return "approval destination or action scope mismatch" }
    return ""
}

func parent_dir(path) {
    mut index := len(path)-1
    while index >= 0 { if substring(path,index,index+1)=="/" { if index==0{return "/"};return substring(path,0,index) }; index=index-1 }
    return "."
}

func ensure_output_parent(path) {
    parent := parent_dir(path)
    if file_exists(parent) {
        if !path_is_dir(parent) { return "publication parent must be a directory" }
        return ""
    }
    parts := split(parent,"/"); mut current := ""; if starts_with(parent,"/"){current="/"}
    for part in parts {
        if part==".." { return "publication path traversal is not allowed" }
        if part!=""&&part!="." {
            if current=="/"{current="/"+part}else if current==""{current=part}else{current=current+"/"+part}
            if file_exists(current) { if !path_is_dir(current){return "publication parent path is not a directory"} }
            else { try { create_dir(current) } except error { return "could not create publication parent" } }
        }
    }
    return ""
}

func publish_local(record, payload, source, output, force, dry_run) {
    if source==""||output=="" { return {"ok":false,"code":"publish_paths_required","error":"local publish requires --path source and --output destination"} }
    if !path_is_file(source)||path_is_symlink(source)||file_size(source)>67108864 { return {"ok":false,"code":"unsafe_artifact","error":"publication source must be a bounded regular file"} }
    if sha256_file(source)!=payload["manifest_checksum"] { return {"ok":false,"code":"checksum_drift","error":"checksum drift detected"} }
    if source==output { return {"ok":false,"code":"unsafe_output","error":"publication source and destination must differ"} }
    for part in split(replace_str(output,"\\","/"),"/"){if part==".."{return {"ok":false,"code":"unsafe_output","error":"publication path traversal is not allowed"}}}
    parent_error:=ensure_output_parent(output);if parent_error!=""{return {"ok":false,"code":"unsafe_output","error":parent_error}}
    if file_exists(output)&&path_is_symlink(output){return {"ok":false,"code":"unsafe_output","error":"publication destination symlinks are not allowed"}}
    if file_exists(output)&&force!=true{return {"ok":false,"code":"output_exists","error":"publication destination exists"}}
    record["artifact"]={"path":source,"sha256":sha256_file(source),"bytes":file_size(source)}
    record["receipt"]={"schema_version":"1.0.0","adapter":"local-filesystem","adapter_version":"0.1.0","provider_id":record["id"],"url":"file:"+output,"idempotency_key":substring(sha256(record["id"]),0,32),"status":"published"}
    if dry_run==true{return {"ok":true,"record":record}}
    temporary:=output+".tmp-"+uuid_v4()
    try { copy_file(source,temporary); rename_file(temporary,output) } except error { if path_is_file(temporary){delete_file(temporary)};return {"ok":false,"code":"publish_failed","error":"atomic local publication failed"} }
    return {"ok":true,"record":record}
}

func create_record(command, parsed, config) {
    source_flag:=flag(parsed,"path","");output_flag:=flag(parsed,"output","");force_flag:=flag(parsed,"force",false);dry_run_flag:=flag(parsed,"dry-run",false)
    state := setting(parsed,config,"state",DEFAULT_STATE)
    initialized:=initialize(state,metadata());if !initialized["ok"]{return initialized}
    input:=read_payload(parsed);if !input["ok"]{return input};payload:=input["value"]
    actor:=setting(parsed,config,"actor","")
    if type(actor)!="string"||trim(actor)==""||len(actor)>256||!regex_match(actor,"^[^\\x00-\\x1F\\x7F]+$"){return {"ok":false,"code":"actor_required","error":"mutating commands require a bounded printable actor"}}
    error:=validate_effect(command,payload,parsed);if error==""{error=validate_approval(command,payload)};if error!=""{return {"ok":false,"code":"authorization_failed","error":error}}
    timestamp:=flag(parsed,"timestamp",now_utc());if !valid_timestamp(timestamp){return {"ok":false,"code":"invalid_timestamp","error":"timestamp must be RFC 3339 UTC"}}
    id:=flag(parsed,"id","")
    if id=="" { if has(EFFECT_COMMANDS,command){id="publication-"+substring(sha256(payload["approval_id"]+"\n"+command+"\n"+payload["destination"]+"\n"+payload["manifest_checksum"]),0,20)}else{id="publication-"+substring(sha256(SLUG+"\n"+command+"\n"+actor+"\n"+timestamp+"\n"+canonical_json(payload)),0,20)} }
    if !safe_id(id)||!starts_with(id,"publication-"){return {"ok":false,"code":"unsafe_id","error":"id must use publication- prefix and safe characters"}}
    record:={"schema_version":"1.0.0","tool_version":VERSION,"contract_version":CONTRACT,"id":id,"record_type":command,"command":command,"actor":actor,"created_at":timestamp,"provenance":get(payload,"provenance",[]),"payload":payload}
    if command=="publish"{published:=publish_local(record,payload,source_flag,output_flag,force_flag,dry_run_flag);if !published["ok"]{return published};record=published["record"]}
    else { path:=flag(parsed,"path","");if path!=""{if !path_is_file(path)||path_is_symlink(path)||file_size(path)>67108864{return {"ok":false,"code":"unsafe_artifact","error":"artifact must be a bounded regular file"}};record["artifact"]={"path":path,"sha256":sha256_file(path),"bytes":file_size(path)} } }
    if dry_run_flag==true{return {"ok":true,"value":{"dry_run":true,"record":record}}}
    stored:=save_new(state,record);if !stored["ok"]{return stored}
    return {"ok":true,"value":record}
}

func verify(parsed,config) {
    state:=setting(parsed,config,"state",DEFAULT_STATE);id:=flag(parsed,"id","");if id==""{return {"ok":false,"code":"id_required","error":"validation requires --id"}}
    loaded:=load_record(state,id);if !loaded["ok"]{return loaded};record:=loaded["value"]
    path:=flag(parsed,"path","");if path!=""{expected:=get(get(record,"artifact",{}),"sha256",get(record["payload"],"manifest_checksum",""));if !path_is_file(path)||path_is_symlink(path)||expected==""||sha256_file(path)!=expected{return {"ok":false,"code":"checksum_drift","error":"checksum drift detected"}}}
    return {"ok":true,"value":{"valid":true,"record_id":record["id"],"checksum":loaded["checksum"]}}
}

export func dispatch(command,parsed) {
    config_result:=load_config(flag(parsed,"config",""));if !config_result["ok"]{return config_result};config:=config_result["value"];state:=setting(parsed,config,"state",DEFAULT_STATE)
    if command=="init"{return initialize(state,metadata())}
    if command=="version"{return {"ok":true,"value":{"tool":SLUG,"version":VERSION,"contract_version":CONTRACT,"minimum_kujo":"1.0.1"}}}
    if command=="doctor"{
        state_error:=validate_state_path(state);listing:={"records":[],"warnings":[],"truncated":false}
        if state_error==""{listing=list_records(state,"","",1000)}
        healthy:=state_error==""&&len(listing["warnings"])==0;mut code:=null;mut error:=null
        if !healthy{code="corrupt_state";error="state is unsafe or contains unreadable records"}
        return {"ok":healthy,"code":code,"error":error,"value":{"healthy":healthy,"state":state,"record_count":len(listing["records"]),"corrupt_records":listing["warnings"],"limits":{"input_bytes":1048576,"artifact_bytes":67108864,"list_records":1000},"limitations":"Local publication cannot be transactionally coupled to state on a different filesystem; failures are reported and never retried implicitly."}}
    }
    if command=="adapters"||command=="capabilities"{return {"ok":true,"value":{"adapters":[{"id":"local-filesystem","version":"0.1.0","effects":["publish"],"offline":true}],"requires_confirmation":EFFECT_COMMANDS}}}
    if command=="show"||command=="receipt"{id:=flag(parsed,"id","");if id==""{return {"ok":false,"code":"id_required","error":"show requires --id"}};return load_record(state,id)}
    if command=="validate"||command=="status"{return verify(parsed,config)}
    if command=="history"||command=="report"{listing:=list_records(state,"","",1000);if len(listing["warnings"])>0&&listing["warnings"][0]["code"]=="unsafe_state"{return {"ok":false,"code":"unsafe_state","error":listing["warnings"][0]["error"]}};return {"ok":true,"value":listing}}
    if command=="export"{listing:=list_records(state,"","",1000);if len(listing["warnings"])>0&&listing["warnings"][0]["code"]=="unsafe_state"{return {"ok":false,"code":"unsafe_state","error":listing["warnings"][0]["error"]}};return {"ok":true,"value":{"schema_version":"1.0.0","tool":SLUG,"records":listing["records"],"warnings":listing["warnings"],"truncated":listing["truncated"]}}}
    return create_record(command,parsed,config)
}

func command_name(argv){if len(argv)==0||argv[0]=="--help"{return "help"};if argv[0]=="--version"{return "version"};return argv[0]}
func command_tokens(argv,command){if command=="help"||(len(argv)>0&&starts_with(argv[0],"--")){return []};return slice(argv,1,len(argv))}

export func main(argv) {
    command:=command_name(argv)
    if command=="help"{print(NAME+" "+VERSION+"\n\nCommands:\n  "+join(COMMANDS,"\n  ")+"\n\nFlags: --state --config --input --id --actor --timestamp --path --json --dry-run --output --force --act --yes");return 0}
    if !has(COMMANDS,command){eprint(NAME+": unknown command: "+command);return 2}
    parsed:=parse_args(command_tokens(argv,command),["json","dry-run","force","act","yes"])
    if len(parsed["errors"])>0{eprint(NAME+": "+parsed["errors"][0]);return 2}
    allowed:=["state","config","input","id","actor","timestamp","path","json","dry-run","output","force","act","yes"]
    for name in keys(parsed["flags"]){if !has(allowed,name){eprint(NAME+": unknown flag --"+name);return 2}}
    if len(parsed["positionals"])>0{eprint(NAME+": unexpected positional argument: "+parsed["positionals"][0]);return 2}
    result:=dispatch(command,parsed);output:=envelope(result["ok"],get(result,"value",null),get(result,"error",null),get(result,"code",null),VERSION,CONTRACT)
    if flag(parsed,"json",false){print(to_json_pretty(output))}else if result["ok"]{print(NAME+": ok\n"+to_json_pretty(get(result,"value",null)))}else{eprint(NAME+": "+get(result,"error","operation failed"))}
    if result["ok"]{return 0};return 1
}
