from src.common import get, has, canonical_json, valid_timestamp

export func adapter_conformance(adapter){if type(adapter)!="dict"||!has(["cms","git-static-site","newsletter"],get(adapter,"provider_class","")){return {"ok":false,"error":"unsupported provider class"}};if get(adapter,"offline_fixture",false)!=true||get(adapter,"implicit_credentials",true)!=false{return {"ok":false,"error":"conformance requires offline fixtures and explicit credentials"}};operations:=get(adapter,"operations",[]);for operation in ["preflight","publish","status","correct","unpublish"]{if !has(operations,operation){return {"ok":false,"error":"missing operation: "+operation}}};return {"ok":true,"conformant":true,"provider_class":adapter["provider_class"]}}

export func effect_receipt(effect){if type(effect)!="dict"{return {"ok":false,"error":"effect must be an object"}};for key in ["effect_id","adapter","idempotency_key","phase","attempt"]{if has_key(effect,key)==0{return {"ok":false,"error":"missing effect field: "+key}}};if !has(["prepared","sent","confirmed","failed","compensated"],effect["phase"])||effect["attempt"]<1||effect["attempt"]>100{return {"ok":false,"error":"invalid effect phase or attempt"}};return {"ok":true,"receipt":{"effect_id":effect["effect_id"],"adapter":effect["adapter"],"idempotency_key":effect["idempotency_key"],"phase":effect["phase"],"attempt":effect["attempt"],"provider_id":get(effect,"provider_id",null),"provider_version":get(effect,"provider_version",null)}}}

export func reconcile_effect(local_receipt,provider_state){checked:=effect_receipt(local_receipt);if !checked["ok"]||type(provider_state)!="dict"{return {"ok":false,"error":"valid local receipt and provider state required"}};remote_phase:=get(provider_state,"phase","");if !has(["absent","published","corrected","unpublished"],remote_phase){return {"ok":false,"error":"invalid provider phase"}};mut action:="inspect";if local_receipt["phase"]=="confirmed"&&remote_phase=="published"{action="complete"}else if local_receipt["phase"]=="sent"&&remote_phase=="published"{action="adopt-confirmation"}else if local_receipt["phase"]=="failed"&&remote_phase=="absent"{action="resume"}else if remote_phase=="unpublished"{action="record-compensation"};return {"ok":true,"action":action,"safe_to_retry":action=="resume"}}

export func compensation_rule(provider_class,action,capabilities){if !has(["cms","git-static-site","newsletter"],provider_class)||!has(["correct","unpublish"],action)||type(capabilities)!="array"{return {"ok":false,"error":"invalid compensation request"}};if action=="correct"&&!has(capabilities,"update"){return {"ok":false,"error":"adapter cannot correct in place"}};if action=="unpublish"&&!has(capabilities,"delete")&&!has(capabilities,"tombstone"){return {"ok":false,"error":"adapter cannot delete or tombstone"}};mut operation:="update";if action=="unpublish"{if has(capabilities,"tombstone"){operation="tombstone"}else{operation="delete"}};return {"ok":true,"operation":operation,"requires_new_approval":true,"preserve_original_receipt":true}}

export func verify_versionseal_evidence(record,signature,verification_key){if type(record)!="dict"||get(record,"command","")!="approve"||get(record,"record_type","")!="decision"||!valid_timestamp(get(record,"created_at","")){return {"ok":false,"error":"invalid VersionSeal approval evidence"}};if type(verification_key)!="string"||len(verification_key)<16{return {"ok":false,"error":"explicit verification key is required"}};payload:=canonical_json(record);if hmac_sha256(verification_key,payload)!=signature{return {"ok":false,"error":"VersionSeal evidence signature mismatch"}};return {"ok":true,"verified":true,"approval_id":get(record,"id","")}}

export func fault_injection_run(steps,fail_at){if type(steps)!="array"||len(steps)==0||len(steps)>100||fail_at<0||fail_at>=len(steps){return {"ok":false,"error":"bounded steps and fail_at index required"}};mut completed:=[];mut pending:=[];mut i:=0;while i<len(steps){if i<fail_at{completed=push(completed,steps[i])}else{pending=push(pending,steps[i])};i=i+1};return {"ok":true,"status":"partial_failure","failed_step":steps[fail_at],"completed":completed,"pending":pending,"implicit_retry":false,"reconciliation_required":true}}
