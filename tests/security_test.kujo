from src.core import dispatch
from src.args import parse_args
mut pass:=0;mut fail:=0;func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}};func opts(v){return parse_args(v,["json","dry-run","force","act","yes"])};root:="/tmp/presswire-security-"+uuid_v4()
check(!dispatch("init",opts(["--state",root+"/../escape"]))["ok"],"state traversal");secret:=root+"-secret";write_file(secret,"{\"schema_version\":\"1.0.0\",\"api_key\":\"nope\"}",true);check(!dispatch("preflight",opts(["--state",root,"--input",secret,"--actor","publisher"]))["ok"],"secret rejection");check(!dispatch("show",opts(["--state",root,"--id","../escape"]))["ok"],"record traversal")
print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
