from src.core import dispatch
from cli import parse_args
mut pass:=0;mut fail:=0
func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}}
root:="/tmp/presswire-test-"+uuid_v4()
func opts(v){return parse_args(v,["json","dry-run","force","act","yes"])}
check(dispatch("init",opts(["--state",root]))["ok"],"init")
created:=dispatch("preflight",opts(["--state",root,"--input","fixtures/core.json","--actor","fixture-human","--timestamp","2026-08-14T00:00:00Z"]))
check(created["ok"],"core workflow");id:="";if created["ok"]{id=created["value"]["id"]}
check(!dispatch("preflight",opts(["--state",root,"--input","fixtures/core.json","--actor","fixture-human","--timestamp","2026-08-14T00:00:00Z"]))["ok"],"duplicate")
check(!dispatch("preflight",opts(["--state",root,"--input","fixtures/core.json"]))["ok"],"actor required")
check(!dispatch("show",opts(["--state",root,"--id","../escape"]))["ok"],"traversal")
bad:=root+"/bad.json";write_file(bad,"{",true);check(!dispatch("preflight",opts(["--state",root,"--input",bad,"--actor","fixture-human"]))["ok"],"malformed JSON")
future:=root+"/future.json";write_file(future,"{\"schema_version\":\"2.0.0\"}",true);check(!dispatch("preflight",opts(["--state",root,"--input",future,"--actor","fixture-human"]))["ok"],"schema major")
check(dispatch("preflight",opts(["--state",root,"--input","fixtures/core.json","--actor","fixture-human","--dry-run"]))["value"]["dry_run"],"dry run")
check(dispatch("doctor",opts(["--state",root]))["value"]["healthy"],"doctor")
check(dispatch("version",opts([]))["value"]["version"]=="0.1.0","version")
check(dispatch("export",opts(["--state",root]))["value"]["schema_version"]=="1.0.0","export")
if id!=""{check(dispatch("show",opts(["--state",root,"--id",id]))["ok"],"show")}
source:=root+"/package.bin";output:=root+"/published/package.bin";write_file(source,"approved package",true)
approval_path:=root+"/approval.json";write_file(approval_path,to_json({"schema_version":"1.0.0","tool_version":"0.1.0","id":"approval-fixture","command":"approve","payload":{"manifest_checksum":sha256_file(source),"destination":"fixture-local","action":"publish"}}),true)
request_path:=root+"/publish.json";write_file(request_path,to_json({"schema_version":"1.0.0","approval_id":"approval-fixture","approval_record_path":approval_path,"manifest_checksum":sha256_file(source),"destination":"fixture-local","authorized_action":"publish","provenance":[]}),true)
base:=["--state",root,"--input",request_path,"--actor","publisher","--path",source,"--output",output,"--act","--yes"]
check(!dispatch("publish",opts(["--state",root,"--input",request_path,"--actor","publisher","--path",source,"--output",output]))["ok"],"ACT requires confirmation")
dry_effect:=dispatch("publish",opts(concat(base,["--dry-run"])));check(dry_effect["ok"]&&!file_exists(output),"publication dry run")
published:=dispatch("publish",opts(base));check(published["ok"]&&read_file(output)=="approved package"&&published["value"]["receipt"]["status"]=="published","bounded local publication and receipt")
check(!dispatch("publish",opts(concat(base,["--timestamp","2026-08-15T00:00:00Z"])))["ok"],"duplicate effect prevented")
write_file(source,"drifted",true);drift_path:=root+"/drift.json";write_file(drift_path,to_json({"schema_version":"1.0.0","approval_id":"approval-other","approval_record_path":approval_path,"manifest_checksum":"wrong","destination":"fixture-local-2","authorized_action":"publish"}),true)
check(!dispatch("publish",opts(["--state",root,"--input",drift_path,"--actor","publisher","--path",source,"--output",root+"/other.bin","--act","--yes"]))["ok"],"checksum drift rejected")
missing_approval:=root+"/missing-approval.json";write_file(missing_approval,to_json({"schema_version":"1.0.0","approval_id":"approval-fixture","manifest_checksum":sha256_file(source),"destination":"fixture-local","authorized_action":"publish"}),true)
check(!dispatch("publish",opts(["--state",root,"--input",missing_approval,"--actor","publisher","--path",source,"--output",root+"/missing.bin","--act","--yes"]))["ok"],"missing VersionSeal record rejected")
print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
