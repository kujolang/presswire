from src.core import dispatch
from src.args import parse_args
mut pass:=0;mut fail:=0;func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}};func opts(v){return parse_args(v,["json","dry-run","force","act","yes"])};root:="/tmp/presswire-domain-"+uuid_v4();source:=root+"-source";write_file(source,"bytes",true);approval:=root+"-approval";write_file(approval,to_json({"schema_version":"1.0.0","tool_version":"0.1.0","contract_version":"1.0.0","id":"approval-exact","record_type":"decision","command":"approve","actor":"exact-approver","created_at":"2026-08-14T00:00:00Z","payload":{"human_actor":"exact-approver","manifest_checksum":sha256_file(source),"destination":"local","action":"publish"}}),true);input:=root+"-input";write_file(input,to_json({"schema_version":"1.0.0","approval_id":"approval-exact","approval_record_path":approval,"manifest_checksum":sha256_file(source),"destination":"local","authorized_action":"publish"}),true)
base:=["--state",root,"--input",input,"--actor","publisher","--path",source,"--output",root+"-out"];check(!dispatch("publish",opts(base))["ok"],"explicit authority required");dry:=dispatch("publish",opts(concat(base,["--act","--yes","--dry-run"])));check(dry["ok"]&&!file_exists(root+"-out"),"effect dry run");published:=dispatch("publish",opts(concat(base,["--act","--yes"])));check(published["ok"]&&read_file(root+"-out")=="bytes","bounded local effect");delete_file(root+"-out");duplicate:=dispatch("publish",opts(concat(base,["--act","--yes"])));check(!duplicate["ok"]&&!file_exists(root+"-out"),"duplicate rejected before repeating effect")
print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
