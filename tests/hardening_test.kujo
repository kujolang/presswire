from src.hardening import adapter_conformance, effect_receipt, reconcile_effect, compensation_rule, verify_versionseal_evidence, fault_injection_run
from src.common import canonical_json
mut pass:=0;mut fail:=0;func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}}
for fixture in ["cms","git-static-site","newsletter"]{check(adapter_conformance(parse_json(read_file("fixtures/adapters/"+fixture+".json")))["ok"],"adapter "+fixture)}
receipt:={"effect_id":"effect-one","adapter":"fixture","idempotency_key":"idem-one","phase":"sent","attempt":1};check(effect_receipt(receipt)["ok"],"effect receipt");check(reconcile_effect(receipt,{"phase":"published"})["action"]=="adopt-confirmation","reconcile sent effect")
check(compensation_rule("cms","correct",["update"])["operation"]=="update","correction rule");check(compensation_rule("newsletter","unpublish",["tombstone"])["operation"]=="tombstone","unpublish rule")
approval:={"id":"approval-fixture","command":"approve","record_type":"decision","created_at":"2026-08-14T00:00:00Z"};key:="fixture-key-123456";signature:=hmac_sha256(key,canonical_json(approval));check(verify_versionseal_evidence(approval,signature,key)["ok"],"signed VersionSeal evidence");check(!verify_versionseal_evidence(approval,signature,"different-key-1234")["ok"],"VersionSeal signature drift")
fault:=fault_injection_run(["prepare","send","confirm"],1);check(fault["status"]=="partial_failure"&&fault["completed"]==["prepare"]&&fault["implicit_retry"]==false,"fault injection")
print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
